@page "/login"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject HttpClient Http
@inject AIKnowledgeAssistant.Web.Services.AuthState AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS
@using System.Net.Http.Json

<div class="page-shell">
    <div class="card" style="max-width: 380px; margin: 0 auto;">
        <h3>Log in</h3>

        <input @bind="email" placeholder="Email" class="field" />
        <input @bind="password" type="password" placeholder="Password" class="field" />
        <button class="btn btn-primary" style="width: 100%;" @onclick="DoLogin">Log in</button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error-text">@errorMessage</p>
        }
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? errorMessage;

    private async Task DoLogin()
    {
        errorMessage = null;
        var response = await Http.PostAsJsonAsync("/api/Auth/login", new { email, password });

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
            AuthState.Token = result?.token;
            AuthState.Email = email;

            await JS.InvokeVoidAsync("authStorage.setToken", result?.token);
            await JS.InvokeVoidAsync("authStorage.setEmail", email);

            Nav.NavigateTo("/upload");
        }
        else
        {
            errorMessage = "Login failed. Check your credentials.";
        }
    }

    private class LoginResponse
    {
        public string? token { get; set; }
    }
}
