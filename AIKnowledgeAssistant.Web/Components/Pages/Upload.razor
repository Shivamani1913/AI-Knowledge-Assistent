@page "/upload"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject HttpClient Http
@inject AIKnowledgeAssistant.Web.Services.AuthState AuthState
@inject IJSRuntime JS
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="page-shell">
    <div class="card">
        <h3>Upload a document</h3>

        @if (!isAuthenticated)
        {
            <p class="muted-text">Please <a href="/login">log in</a> first.</p>
        }
        else
        {
            <p class="muted-text">Logged in as @AuthState.Email</p>
            <InputFile OnChange="OnFileSelected" />

            @if (!string.IsNullOrEmpty(status))
            {
                <div class="status-banner">@status</div>
            }

            <p style="margin-top: 1.25rem;"><a href="/chat">Go to Chat &rarr;</a></p>
        }
    </div>
</div>

@code {
    private string status = "";
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            var token = await JS.InvokeAsync<string?>("authStorage.getToken");
            var email = await JS.InvokeAsync<string?>("authStorage.getEmail");

            if (!string.IsNullOrEmpty(token))
            {
                AuthState.Token = token;
                AuthState.Email = email;
            }
        }

        isAuthenticated = AuthState.IsAuthenticated;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        status = "Uploading...";

        using var content = new MultipartFormDataContent();
        var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
        var fileContent = new StreamContent(stream);
        var contentType = string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType;
        fileContent.Headers.ContentType = new MediaTypeHeaderValue(contentType);
        content.Add(fileContent, "file", file.Name);

        var request = new HttpRequestMessage(HttpMethod.Post, "/api/Documents/upload") { Content = content };
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", AuthState.Token);

        var response = await Http.SendAsync(request);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<UploadResponse>();
            status = "Uploaded. Processing in the background — document ID " + result?.documentId;
        }
        else
        {
            status = "Upload failed: " + response.StatusCode;
        }
    }

    private class UploadResponse
    {
        public Guid documentId { get; set; }
    }
}
